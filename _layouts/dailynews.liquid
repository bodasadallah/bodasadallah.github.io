---
layout: default
---
<div class="post daily-news">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ page.date | date: '%A, %B %d, %Y' }}
      {% if page.sources %}• compiled from {{ page.sources }} sources{% endif %}
      {% if page.papers %}• {{ page.papers }} papers for me{% endif %}
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  <p class="dn-footer">
    <a href="{{ '/daily-news/' | relative_url }}">← All daily news</a>
  </p>
</div>
